# Must be a wss: origin only and share the host with CLAWCHAT_RAILWAY_ORIGIN.
NEXT_PUBLIC_RAILWAY_WS_BASE_URL=wss://your-backend.up.railway.app
# Optional public HTTPS directory containing `illustrated/` and the full avatar
# catalogue. Without it, Relay Console offers only six bundled fallbacks.
NEXT_PUBLIC_RELAY_AVATAR_ASSET_BASE_URL=
NEXT_PUBLIC_ENABLE_OPERATIONS=false
NEXT_PUBLIC_ENABLE_CONDENSED_TEAM_CHAT=false
NEXT_PUBLIC_ENABLE_CONDENSED_TEAM_CHAT_REALTIME=false
NEXT_PUBLIC_ENABLE_AGENT_OPS=false
NEXT_PUBLIC_ENABLE_AGENT_OPS_DEBUG_CONTROLS=false
NEXT_PUBLIC_ENABLE_MARKETPLACE=true
NEXT_PUBLIC_ENABLE_LOCAL_WORKSPACE_FILES=false
# Public SDK routing identifiers. They are inert until a user opts in.
NEXT_PUBLIC_POSTHOG_PROJECT_ID=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TELEMETRY_ENVIRONMENT=development
# Optional build-only Sentry source-map upload credentials. Set all three in
# the deployment build environment; they are secrets and must never be public.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Must be an https: origin only and share the host with NEXT_PUBLIC_RAILWAY_WS_BASE_URL.
CLAWCHAT_RAILWAY_ORIGIN=https://your-backend.up.railway.app

# Optional release-evidence pin. Set this to the GitHub owner/repository used by
# your production Vercel deployment.
RELAY_RELEASE_REPOSITORY=your-github-owner/relay-console

# Internal visual/demo routes are closed in public deployments.
CLAWCHAT_ENABLE_INTERNAL_DEMO_ROUTES=false

# Web-hosted Mission Control and its host process/repository variables are
# retired. Do not configure the former UI/API flags, secret, or path profiles.

# Railway-only backend configuration.
# Do not set localhost or other local backend overrides in this app.

# Public, non-secret release metadata. Leave unset until the exact signed,
# notarized DMG and checksum are published. The strict JSON shape is defined by
# RelayConsoleSwift/Release/macos-update-manifest.schema.json.
# RELAY_MACOS_UPDATE_MANIFEST_JSON=
