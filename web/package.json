{
  "name": "@clawchat/web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/ensure-local-https-cert.mjs && next dev --turbopack --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem --hostname localhost --port 3033",
    "dev:webpack": "node scripts/ensure-local-https-cert.mjs && next dev --webpack --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem --hostname localhost --port 3033",
    "dev:reset-cache": "node scripts/reset-turbopack-cache.mjs",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start --hostname localhost --port 3033",
    "lint": "eslint && node scripts/check-typography.mjs",
    "lint:ci": "eslint --max-warnings=0 && node scripts/check-typography.mjs",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test components/agent-ops-hq/domain/__tests__/*.test.ts components/marketplace/*.test.ts security/*.test.ts",
    "test:agentops": "node --import tsx --test components/agent-ops-hq/domain/__tests__/*.test.ts",
    "test:marketplace": "node --import tsx --test components/marketplace/*.test.ts",
    "test:security": "node --import tsx --test security/*.test.ts",
    "audit:prod": "node ../scripts/dependency-advisory-gate.mjs web",
    "verify:beta": "pnpm run typecheck && pnpm run lint:ci && pnpm run test && pnpm run build:webpack",
    "verify:beta:full": "pnpm run verify:beta && pnpm run audit:prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@clawchat/contracts": "workspace:*",
    "@clawchat/web-sdk": "workspace:*",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@remixicon/react": "^4.9.0",
    "@sentry/nextjs": "^10.68.0",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "lucide-react": "^0.552.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "pixi.js": "^8.18.1",
    "posthog-js": "^1.407.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.1",
    "typescript": "^5.9.3"
  }
}
