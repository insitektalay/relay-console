# Copy this file to owner.env and restrict it to your account with chmod 600.
# Scripts preserve an explicit shell variable instead of replacing it from here.

CLAWCHAT_RAILWAY_ORIGIN=https://your-backend.up.railway.app
NEXT_PUBLIC_RAILWAY_WS_BASE_URL=wss://your-backend.up.railway.app

# Product telemetry remains disabled when these values are empty.
RELAY_POSTHOG_PROJECT_TOKEN=
RELAY_POSTHOG_HOST=https://eu.i.posthog.com
RELAY_SENTRY_DSN=
RELAY_TELEMETRY_ENVIRONMENT=development

# Sentry uses these only to upload release symbols.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
