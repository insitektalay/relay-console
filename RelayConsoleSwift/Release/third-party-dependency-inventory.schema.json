{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "third-party-dependency-inventory.schema.json",
  "title": "Relay Console production dependency notice inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surfaces"],
  "properties": {
    "schemaVersion": { "const": "relay.third-party-dependency-inventory.v1" },
    "surfaces": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label", "lockfilePath", "lockfileSHA256", "packageVersionCount",
        "legalReviewCategories", "packages"
      ],
      "properties": {
        "id": { "enum": ["backend", "web", "landing"] },
        "label": { "type": "string", "minLength": 1 },
        "lockfilePath": { "type": "string", "minLength": 1 },
        "lockfileSHA256": { "$ref": "#/$defs/sha256" },
        "packageVersionCount": { "type": "integer", "minimum": 1 },
        "legalReviewCategories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/package" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    }
  }
}
