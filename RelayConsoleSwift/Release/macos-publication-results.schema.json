{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macos-publication-results.schema.json",
  "title": "Relay Console completed macOS publication results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "completedAt",
    "releaseHistory",
    "publicationReview",
    "cleanMachine",
    "lifecycle",
    "policy",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "relay.macos-publication-results.v1" },
    "completedAt": { "type": "string", "format": "date-time" },
    "releaseHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstPublicRelease"],
      "properties": {
        "firstPublicRelease": { "type": "boolean" }
      }
    },
    "publicationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downloadPageMatchesArtifact",
        "releaseNotesMatchArtifact",
        "supportPathUsable",
        "updateManifestReviewed",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "downloadPageMatchesArtifact": { "const": true },
        "releaseNotesMatchArtifact": { "const": true },
        "supportPathUsable": { "const": true },
        "updateManifestReviewed": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "cleanMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportedMacPassed",
        "developmentToolsAbsent",
        "independentHermesPassed",
        "independentOpenClawPassed",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "supportedMacPassed": { "const": true },
        "developmentToolsAbsent": { "const": true },
        "independentHermesPassed": { "const": true },
        "independentOpenClawPassed": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseMigrationPassed",
        "exportPassed",
        "resetPassed",
        "updatePassed",
        "rollbackPassed",
        "keychainContinuityPassed",
        "uninstallBoundaryPassed",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "databaseMigrationPassed": { "const": true },
        "exportPassed": { "const": true },
        "resetPassed": { "const": true },
        "updatePassed": { "const": true },
        "rollbackPassed": { "const": true },
        "keychainContinuityPassed": { "const": true },
        "uninstallBoundaryPassed": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manualSignedUpdates",
        "rollbackPolicyPublished",
        "minimumPreviousDMGRetentionDays",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "manualSignedUpdates": { "const": true },
        "rollbackPolicyPublished": { "const": true },
        "minimumPreviousDMGRetentionDays": { "type": "integer", "minimum": 30 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialsIncluded",
        "secretValuesIncluded",
        "customerContentIncluded",
        "customerIdentifiersIncluded",
        "rawScreenshotsIncluded",
        "rawMachineInventoryIncluded"
      ],
      "properties": {
        "credentialsIncluded": { "const": false },
        "secretValuesIncluded": { "const": false },
        "customerContentIncluded": { "const": false },
        "customerIdentifiersIncluded": { "const": false },
        "rawScreenshotsIncluded": { "const": false },
        "rawMachineInventoryIncluded": { "const": false }
      }
    }
  },
  "$defs": {
    "nonPlaceholder": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^<>]+$"
    },
    "evidenceURL": {
      "type": "string",
      "pattern": "^https://"
    }
  }
}
