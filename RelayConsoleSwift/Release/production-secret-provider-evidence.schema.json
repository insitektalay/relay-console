{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayconsole.work/schemas/production-secret-provider-evidence.schema.json",
  "title": "Relay production secret provider evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "status",
    "sourceCommit",
    "railway",
    "vercel",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "relay.production-secret-provider-evidence.v1"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "railway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableDeployment",
        "topologyCapturedAt",
        "identity",
        "attestation"
      ],
      "properties": {
        "stableDeployment": { "type": "boolean" },
        "topologyCapturedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "identity": { "$ref": "#/$defs/railwayIdentity" },
        "attestation": { "$ref": "#/$defs/attestation" }
      }
    },
    "vercel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "deployment", "variables"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["teamId", "projectId", "projectName"],
          "properties": {
            "teamId": { "type": "string", "minLength": 1 },
            "projectId": { "type": "string", "minLength": 1 },
            "projectName": { "type": "string", "minLength": 1 }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "projectId",
            "state",
            "target",
            "sourceCommit",
            "createdAt",
            "url"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "projectId": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "createdAt": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "url": {
              "type": ["string", "null"],
              "format": "uri"
            }
          }
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vercelVariable" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerValuesRetrieved",
        "providerValuesIncluded",
        "secretFingerprintsIncluded",
        "credentialLengthsIncluded"
      ],
      "properties": {
        "providerValuesRetrieved": { "const": false },
        "providerValuesIncluded": { "const": false },
        "secretFingerprintsIncluded": { "const": false },
        "credentialLengthsIncluded": { "const": false }
      }
    }
  },
  "$defs": {
    "railwayIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "environmentId",
        "serviceId",
        "deploymentId",
        "sourceCommit"
      ],
      "properties": {
        "projectId": { "type": "string" },
        "environmentId": { "type": "string" },
        "serviceId": { "type": "string" },
        "deploymentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sourceCommit": { "type": "string" }
      }
    },
    "attestationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "projectId",
        "environmentId",
        "environmentName",
        "serviceId",
        "serviceName",
        "deploymentId",
        "sourceCommit"
      ],
      "properties": {
        "provider": { "const": "railway" },
        "projectId": { "type": "string" },
        "environmentId": { "type": "string" },
        "environmentName": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "deploymentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sourceCommit": { "type": "string" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "capturedAt",
        "status",
        "identity",
        "features",
        "coverage",
        "materials",
        "lifecycle",
        "privacy"
      ],
      "properties": {
        "schemaVersion": { "const": "relay.production-secret-audit.v2" },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": { "enum": ["passed", "failed"] },
        "identity": { "$ref": "#/$defs/attestationIdentity" },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transactionalEmail",
            "stripeBilling",
            "appleBilling",
            "managedCloud",
            "marketplaceBetaGate",
            "marketplaceKillSwitch",
            "signupMode"
          ],
          "properties": {
            "transactionalEmail": { "type": "boolean" },
            "stripeBilling": { "type": "boolean" },
            "appleBilling": { "type": "boolean" },
            "managedCloud": { "type": "boolean" },
            "marketplaceBetaGate": { "type": "boolean" },
            "marketplaceKillSwitch": { "type": "boolean" },
            "signupMode": {
              "enum": ["invite", "public", ""]
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coreSecretCount",
            "materialCount",
            "serviceSecretCount",
            "oauthSecretCount",
            "webhookSecretCount",
            "databaseCredentialChecked",
            "redisCredentialChecked",
            "cookieSigningUsesJwtSecrets",
            "csrfUsesPerSessionRandomUuid",
            "publicSecretVariableCount",
            "distinctMaterialChecked",
            "lifecycleRegistryChecked",
            "deploymentIdentityChecked",
            "connectionDescriptorKeyPairVerified"
          ],
          "properties": {
            "coreSecretCount": { "type": "integer", "minimum": 0 },
            "materialCount": { "type": "integer", "minimum": 0 },
            "serviceSecretCount": { "type": "integer", "minimum": 0 },
            "oauthSecretCount": { "type": "integer", "minimum": 0 },
            "webhookSecretCount": { "type": "integer", "minimum": 0 },
            "databaseCredentialChecked": { "type": "boolean" },
            "redisCredentialChecked": { "type": "boolean" },
            "cookieSigningUsesJwtSecrets": { "type": "boolean" },
            "csrfUsesPerSessionRandomUuid": { "type": "boolean" },
            "publicSecretVariableCount": {
              "type": "integer",
              "minimum": 0
            },
            "distinctMaterialChecked": { "type": "boolean" },
            "lifecycleRegistryChecked": { "type": "boolean" },
            "deploymentIdentityChecked": { "type": "boolean" },
            "connectionDescriptorKeyPairVerified": { "type": "boolean" }
          }
        },
        "materials": {
          "type": "array",
          "items": { "$ref": "#/$defs/material" }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "materials"],
          "properties": {
            "schemaVersion": {
              "type": ["string", "null"]
            },
            "materials": {
              "type": "array",
              "items": { "$ref": "#/$defs/lifecycleMaterial" }
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secretValuesIncluded",
            "secretFingerprintsIncluded",
            "credentialLengthsIncluded",
            "providerVariableValuesRetrieved"
          ],
          "properties": {
            "secretValuesIncluded": { "const": false },
            "secretFingerprintsIncluded": { "const": false },
            "credentialLengthsIncluded": { "const": false },
            "providerVariableValuesRetrieved": { "const": false }
          }
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification",
        "minimumBytesPolicy",
        "present",
        "strengthPolicyPassed",
        "distinctMaterialPassed",
        "lifecycleTracked"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[A-Za-z0-9._-]+\\])?$"
        },
        "classification": {
          "enum": [
            "application",
            "encryption",
            "provider-database",
            "provider-cache",
            "invite-seed",
            "retained-invite-hash",
            "retained-encryption",
            "provider-issued"
          ]
        },
        "minimumBytesPolicy": { "enum": [16, 32] },
        "present": { "type": "boolean" },
        "strengthPolicyPassed": { "type": "boolean" },
        "distinctMaterialPassed": { "type": "boolean" },
        "lifecycleTracked": { "type": "boolean" }
      }
    },
    "lifecycleMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "lastRotatedAt",
        "lastReviewedAt",
        "nextReviewAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[[A-Za-z0-9._-]+\\])?$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "lastRotatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "lastReviewedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "nextReviewAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "vercelVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "type",
        "targets",
        "createdAt",
        "updatedAt",
        "gitBranch",
        "customEnvironmentIds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "createdAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "updatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "gitBranch": { "type": ["string", "null"] },
        "customEnvironmentIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
