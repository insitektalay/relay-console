{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-journey-evidence.schema.json",
  "title": "Relay Console release-bound launch journey evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseId", "capturedAt", "candidate", "releaseBinding",
    "artifacts", "results", "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "relay.launch-journey-evidence.v1" },
    "releaseId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "manifestSHA256"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "manifestSHA256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBranch", "railwayDeploymentId", "vercelDeploymentId",
        "railwayTopologySHA256", "railwayConfigurationSHA256", "remoteEvidenceSHA256"
      ],
      "properties": {
        "sourceBranch": { "type": "string", "pattern": "^release/.+" },
        "railwayDeploymentId": { "type": "string", "minLength": 1 },
        "vercelDeploymentId": { "type": "string", "minLength": 1 },
        "railwayTopologySHA256": { "$ref": "#/$defs/sha256" },
        "railwayConfigurationSHA256": { "$ref": "#/$defs/sha256" },
        "remoteEvidenceSHA256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macOSDistributionSHA256", "iOSDistributionSHA256"],
      "properties": {
        "macOSDistributionSHA256": { "$ref": "#/$defs/sha256" },
        "iOSDistributionSHA256": { "$ref": "#/$defs/sha256" }
      }
    },
    "results": { "$ref": "launch-journey-results.schema.json" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialsIncluded", "secretValuesIncluded", "customerContentIncluded",
        "customerIdentifiersIncluded", "testAccountIdentifiersIncluded",
        "rawCommandOutputIncluded"
      ],
      "properties": {
        "credentialsIncluded": { "const": false },
        "secretValuesIncluded": { "const": false },
        "customerContentIncluded": { "const": false },
        "customerIdentifiersIncluded": { "const": false },
        "testAccountIdentifiersIncluded": { "const": false },
        "rawCommandOutputIncluded": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
