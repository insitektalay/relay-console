{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ios-distribution-evidence.schema.json",
  "title": "Relay Console iOS distribution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseId", "capturedAt", "candidate", "archive",
    "signing", "provisioning", "appStoreConnect"
  ],
  "properties": {
    "schemaVersion": { "const": "relay.ios-distribution-evidence.v1" },
    "releaseId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "appBundleSHA256", "appVersion", "appBuild", "bundleIdentifier",
        "minimumOS", "architectures"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[^/]+\\.xcarchive$" },
        "appBundleSHA256": { "$ref": "#/$defs/sha256" },
        "appVersion": { "type": "string", "minLength": 1 },
        "appBuild": { "type": "string", "minLength": 1 },
        "bundleIdentifier": { "const": "com.relayconsole.app" },
        "minimumOS": { "type": "string", "minLength": 1 },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "arm64" }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority", "teamIdentifier", "appCDHash", "strictVerificationPassed",
        "distributionSignature"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "pattern": "^(?:Apple Distribution|iPhone Distribution):"
        },
        "teamIdentifier": { "$ref": "#/$defs/teamIdentifier" },
        "appCDHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{40,64}$" },
        "strictVerificationPassed": { "const": true },
        "distributionSignature": { "const": true }
      }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileUUID", "profileName", "teamIdentifier", "applicationIdentifier",
        "expirationDate", "getTaskAllow", "hasProvisionedDevices",
        "provisionsAllDevices"
      ],
      "properties": {
        "profileUUID": { "type": "string", "format": "uuid" },
        "profileName": { "type": "string", "minLength": 1 },
        "teamIdentifier": { "$ref": "#/$defs/teamIdentifier" },
        "applicationIdentifier": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}\\.com\\.relayconsole\\.app$"
        },
        "expirationDate": { "type": "string", "format": "date-time" },
        "getTaskAllow": { "const": false },
        "hasProvisionedDevices": { "const": false },
        "provisionsAllDevices": { "const": false }
      }
    },
    "appStoreConnect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiOrigin", "appId", "buildId", "processingState", "buildAudienceType",
        "uploadedDate", "expired", "minimumOS", "marketingVersion", "buildNumber"
      ],
      "properties": {
        "apiOrigin": { "const": "https://api.appstoreconnect.apple.com" },
        "appId": { "type": "string", "minLength": 1 },
        "buildId": { "type": "string", "minLength": 1 },
        "processingState": { "const": "VALID" },
        "buildAudienceType": { "const": "APP_STORE_ELIGIBLE" },
        "uploadedDate": { "type": "string", "format": "date-time" },
        "expired": { "const": false },
        "minimumOS": { "type": "string", "minLength": 1 },
        "marketingVersion": { "type": "string", "minLength": 1 },
        "buildNumber": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "teamIdentifier": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "manifestSHA256"],
      "properties": {
        "sourceCommit": { "$ref": "#/$defs/commit" },
        "manifestSHA256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
