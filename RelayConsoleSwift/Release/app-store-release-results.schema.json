{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app-store-release-results.schema.json",
  "title": "Relay Console completed App Store release results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "completedAt",
    "app",
    "listing",
    "privacyDisclosures",
    "reviewPath",
    "deviceAcceptance",
    "testFlight",
    "appReview",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "relay.app-store-release-results.v1"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "buildId",
        "bundleIdentifier",
        "teamIdentifier",
        "version",
        "build",
        "locale"
      ],
      "properties": {
        "appId": { "type": "string", "minLength": 1 },
        "buildId": { "type": "string", "minLength": 1 },
        "bundleIdentifier": { "const": "com.relayconsole.app" },
        "teamIdentifier": { "$ref": "#/$defs/teamIdentifier" },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "locale": { "const": "en-GB" }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadataSubmitted",
        "metadataReviewed",
        "iPhoneScreenshotsSubmitted",
        "iPadScreenshotsSubmitted",
        "screenshotsMatchBuild",
        "privacyURL",
        "supportURL",
        "termsURL",
        "ageRatingCompleted",
        "exportComplianceCompleted",
        "reviewNotesSubmitted",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "metadataSubmitted": { "const": true },
        "metadataReviewed": { "const": true },
        "iPhoneScreenshotsSubmitted": { "const": true },
        "iPadScreenshotsSubmitted": { "const": true },
        "screenshotsMatchBuild": { "const": true },
        "privacyURL": { "const": "https://relayconsole.work/privacy" },
        "supportURL": { "const": "https://relayconsole.work/support" },
        "termsURL": { "const": "https://relayconsole.work/terms" },
        "ageRatingCompleted": { "const": true },
        "exportComplianceCompleted": { "const": true },
        "reviewNotesSubmitted": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "privacyDisclosures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted",
        "reviewedAgainstFrozenBinary",
        "reviewedAgainstFrozenMarketplace",
        "tracking",
        "categories",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "submitted": { "const": true },
        "reviewedAgainstFrozenBinary": { "const": true },
        "reviewedAgainstFrozenMarketplace": { "const": true },
        "tracking": { "const": false },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account",
            "messages",
            "providerConnections",
            "diagnostics",
            "purchases",
            "deviceData",
            "telemetry"
          ],
          "properties": {
            "account": { "const": true },
            "messages": { "const": true },
            "providerConnections": { "const": true },
            "diagnostics": { "const": true },
            "purchases": { "const": true },
            "deviceData": { "const": true },
            "telemetry": { "const": true }
          }
        },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "reviewPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountEmailVerified",
        "writableSubscription",
        "runtimeBridgeOnline",
        "agentAvailable",
        "messageRoundTripPassed",
        "restorePurchasesPassed",
        "accountExportPassed",
        "accountDeletionPassed",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "accountEmailVerified": { "const": true },
        "writableSubscription": { "const": true },
        "runtimeBridgeOnline": { "const": true },
        "agentAvailable": { "const": true },
        "messageRoundTripPassed": { "const": true },
        "restorePurchasesPassed": { "const": true },
        "accountExportPassed": { "const": true },
        "accountDeletionPassed": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "deviceAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iPhonePassed",
        "iPadPassed",
        "dynamicTypePassed",
        "voiceOverPassed",
        "darkModePassed",
        "keyboardPassed",
        "supportedRotationPassed",
        "poorNetworkPassed",
        "offlineRuntimePassed",
        "expiredSubscriptionPassed",
        "expiredAuthenticationPassed",
        "reviewedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "iPhonePassed": { "const": true },
        "iPadPassed": { "const": true },
        "dynamicTypePassed": { "const": true },
        "voiceOverPassed": { "const": true },
        "darkModePassed": { "const": true },
        "keyboardPassed": { "const": true },
        "supportedRotationPassed": { "const": true },
        "poorNetworkPassed": { "const": true },
        "offlineRuntimePassed": { "const": true },
        "expiredSubscriptionPassed": { "const": true },
        "expiredAuthenticationPassed": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "testFlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "external"],
      "properties": {
        "internal": { "$ref": "#/$defs/testFlightAcceptance" },
        "external": { "$ref": "#/$defs/testFlightAcceptance" }
      }
    },
    "appReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalStatus",
        "submissionId",
        "submittedBuildId",
        "storeState",
        "rejectionCount",
        "resolvedRejectionCount",
        "unresolvedRejectionCount",
        "reviewedAt",
        "verifiedBy",
        "evidenceURL"
      ],
      "properties": {
        "approvalStatus": { "const": "approved" },
        "submissionId": { "type": "string", "minLength": 1 },
        "submittedBuildId": { "type": "string", "minLength": 1 },
        "storeState": {
          "enum": [
            "PENDING_DEVELOPER_RELEASE",
            "READY_FOR_SALE",
            "READY_FOR_DISTRIBUTION"
          ]
        },
        "rejectionCount": { "type": "integer", "minimum": 0 },
        "resolvedRejectionCount": { "type": "integer", "minimum": 0 },
        "unresolvedRejectionCount": { "const": 0 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialsIncluded",
        "secretValuesIncluded",
        "reviewAccountIdentifiersIncluded",
        "customerContentIncluded",
        "paymentIdentifiersIncluded",
        "rawScreenshotsIncluded"
      ],
      "properties": {
        "credentialsIncluded": { "const": false },
        "secretValuesIncluded": { "const": false },
        "reviewAccountIdentifiersIncluded": { "const": false },
        "customerContentIncluded": { "const": false },
        "paymentIdentifiersIncluded": { "const": false },
        "rawScreenshotsIncluded": { "const": false }
      }
    }
  },
  "$defs": {
    "teamIdentifier": {
      "type": "string",
      "pattern": "^[A-Z0-9]{10}$"
    },
    "nonPlaceholder": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^<>]+$"
    },
    "evidenceURL": {
      "type": "string",
      "pattern": "^https://"
    },
    "testFlightAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "testedBuildId",
        "iPhoneCovered",
        "iPadCovered",
        "completedAt",
        "reviewer",
        "evidenceURL"
      ],
      "properties": {
        "status": { "const": "passed" },
        "testedBuildId": { "type": "string", "minLength": 1 },
        "iPhoneCovered": { "const": true },
        "iPadCovered": { "const": true },
        "completedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "$ref": "#/$defs/evidenceURL" }
      }
    }
  }
}
