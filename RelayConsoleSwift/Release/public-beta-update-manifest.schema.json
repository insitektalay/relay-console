{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay Console Public Beta Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "publishedAt", "latest", "releaseNotesURL", "supportURL"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "const": "public-beta" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "latest": { "$ref": "#/$defs/artifact" },
    "previous": { "$ref": "#/$defs/artifact" },
    "releaseNotesURL": { "type": "string", "format": "uri", "pattern": "^https://" },
    "supportURL": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "dmgURL", "dmgSHA256", "architectures", "minimumMacOSVersion"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" },
        "build": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "dmgURL": { "type": "string", "format": "uri", "pattern": "^https://" },
        "dmgSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["arm64", "x86_64"] } },
        "minimumMacOSVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" }
      }
    }
  }
}
