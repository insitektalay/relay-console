{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay Console Public Beta Sparkle Publication Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "publishedAt", "updateMechanism", "appcastURL", "latest", "releaseNotesURL", "supportURL"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "const": "public-beta" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "updateMechanism": { "const": "sparkle-2" },
    "appcastURL": { "const": "https://insitektalay.github.io/clawchat/appcast.xml" },
    "latest": { "$ref": "#/$defs/artifact" },
    "previous": { "$ref": "#/$defs/artifact" },
    "releaseNotesURL": { "type": "string", "format": "uri", "pattern": "^https://" },
    "supportURL": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "sparkleArchiveURL", "sparkleEdSignature", "architectures", "minimumMacOSVersion"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" },
        "build": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "sparkleArchiveURL": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/insitektalay/clawchat/releases/download/" },
        "sparkleEdSignature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" },
        "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["arm64", "x86_64"] } },
        "minimumMacOSVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$" }
      }
    }
  }
}
