{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-governance-results.schema.json",
  "title": "Relay Console completed launch governance results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "completedAt", "launchCountries", "approvals",
    "support", "productClaims", "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "relay.launch-governance-results.v3" },
    "completedAt": { "type": "string", "format": "date-time" },
    "launchCountries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legalPolicyReview", "acceptableUseApproval", "supportApproval",
        "productClaimsApproval", "dataHandlingApproval",
        "thirdPartyNoticesApproval"
      ],
      "properties": {
        "legalPolicyReview": { "$ref": "#/$defs/legalApproval" },
        "acceptableUseApproval": { "$ref": "#/$defs/approval" },
        "supportApproval": { "$ref": "#/$defs/approval" },
        "productClaimsApproval": { "$ref": "#/$defs/approval" },
        "dataHandlingApproval": { "$ref": "#/$defs/approval" },
        "thirdPartyNoticesApproval": { "$ref": "#/$defs/noticeApproval" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address", "hoursPublished", "responseTargetPublished",
        "mailRoutingVerified", "accountableOwner"
      ],
      "properties": {
        "address": { "type": "string", "format": "email" },
        "hoursPublished": { "const": true },
        "responseTargetPublished": { "const": true },
        "mailRoutingVerified": { "const": true },
        "accountableOwner": { "$ref": "#/$defs/nonPlaceholder" }
      }
    },
    "productClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relayMonthlyPriceUSD", "relayTaxDisclosure",
        "customerOperatedRuntime", "paidEntitlementRequired",
        "managedRuntimeAvailableAtLaunch",
        "enterpriseAvailableAtLaunch"
      ],
      "properties": {
        "relayMonthlyPriceUSD": { "const": "9.99" },
        "relayTaxDisclosure": {
          "enum": ["includes-tax", "excludes-tax", "varies-by-region"]
        },
        "customerOperatedRuntime": { "const": true },
        "paidEntitlementRequired": { "const": true },
        "managedRuntimeAvailableAtLaunch": { "const": false },
        "enterpriseAvailableAtLaunch": { "const": false }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialsIncluded", "secretValuesIncluded", "customerContentIncluded",
        "customerIdentifiersIncluded", "rawDocumentBodiesIncluded"
      ],
      "properties": {
        "credentialsIncluded": { "const": false },
        "secretValuesIncluded": { "const": false },
        "customerContentIncluded": { "const": false },
        "customerIdentifiersIncluded": { "const": false },
        "rawDocumentBodiesIncluded": { "const": false }
      }
    }
  },
  "$defs": {
    "nonPlaceholder": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^<>]+$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "reviewedAt", "reviewer", "reviewerRole", "evidenceURL"],
      "properties": {
        "approved": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "reviewerRole": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "type": "string", "pattern": "^https://" }
      }
    },
    "legalApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved", "qualifiedForLaunchCountries", "reviewedAt",
        "reviewer", "reviewerRole", "evidenceURL"
      ],
      "properties": {
        "approved": { "const": true },
        "qualifiedForLaunchCountries": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "reviewerRole": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "type": "string", "pattern": "^https://" }
      }
    },
    "noticeApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved", "lockedDependencyInventoryReviewed",
        "requiredLicenseTextsPresent", "reviewedAt", "reviewer",
        "reviewerRole", "evidenceURL"
      ],
      "properties": {
        "approved": { "const": true },
        "lockedDependencyInventoryReviewed": { "const": true },
        "requiredLicenseTextsPresent": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "$ref": "#/$defs/nonPlaceholder" },
        "reviewerRole": { "$ref": "#/$defs/nonPlaceholder" },
        "evidenceURL": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
