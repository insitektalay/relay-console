{
  "schemaVersion": "relay.marketplace-provider-acceptance.v1",
  "manifestVersion": "<marketplace-manifest-version>",
  "providerSlug": "<provider-slug>",
  "capturedAt": "<ISO-8601-time>",
  "releaseBinding": {
    "providerSourceCommit": "<40-character-staging-source-commit>",
    "stagingDeploymentId": "<railway-staging-deployment-id>",
    "stagingSourceBranch": "<marketplace-staging-branch>"
  },
  "provider": {
    "connectionType": "oauth",
    "officialDocsURL": "https://<official-provider-documentation>",
    "officialDocsReviewedAt": "<YYYY-MM-DD>",
    "dedicatedTestAccount": true,
    "leastPrivilege": true
  },
  "boundedAction": {
    "actionName": "<reversible-live-action>",
    "reversible": true,
    "cleanupConfirmed": false
  },
  "journeys": {
    "connect": { "status": "pending", "verifiedAt": "<ISO-8601-time>", "reviewer": "<reviewer>", "evidenceURL": "https://<private-evidence-url>", "providerImpact": "test-account-only", "credentialMaterialIncluded": false, "providerObjectIdentifiersIncluded": false, "testAccountIdentifiersIncluded": false },
    "failureOrDenial": { "status": "pending", "verifiedAt": "<ISO-8601-time>", "reviewer": "<reviewer>", "evidenceURL": "https://<private-evidence-url>", "providerImpact": "test-account-only", "credentialMaterialIncluded": false, "providerObjectIdentifiersIncluded": false, "testAccountIdentifiersIncluded": false },
    "connectionStatus": { "status": "pending", "verifiedAt": "<ISO-8601-time>", "reviewer": "<reviewer>", "evidenceURL": "https://<private-evidence-url>", "providerImpact": "none", "credentialMaterialIncluded": false, "providerObjectIdentifiersIncluded": false, "testAccountIdentifiersIncluded": false },
    "boundedLiveAction": { "status": "pending", "verifiedAt": "<ISO-8601-time>", "reviewer": "<reviewer>", "evidenceURL": "https://<private-evidence-url>", "providerImpact": "test-account-only", "credentialMaterialIncluded": false, "providerObjectIdentifiersIncluded": false, "testAccountIdentifiersIncluded": false },
    "reconnect": { "status": "pending", "verifiedAt": "<ISO-8601-time>", "reviewer": "<reviewer>", "evidenceURL": "https://<private-evidence-url>", "providerImpact": "none", "credentialMaterialIncluded": false, "providerObjectIdentifiersIncluded": false, "testAccountIdentifiersIncluded": false },
    "revokeAndDisconnect": { "status": "pending", "verifiedAt": "<ISO-8601-time>", "reviewer": "<reviewer>", "evidenceURL": "https://<private-evidence-url>", "providerImpact": "test-account-only", "credentialMaterialIncluded": false, "providerObjectIdentifiersIncluded": false, "testAccountIdentifiersIncluded": false }
  },
  "privacy": {
    "credentialsIncluded": false,
    "secretValuesIncluded": false,
    "providerObjectIdentifiersIncluded": false,
    "testAccountIdentifiersIncluded": false,
    "customerContentIncluded": false,
    "rawCommandOutputIncluded": false
  }
}
