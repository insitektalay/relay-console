// Copy this file to RelayConsoleOwner.xcconfig. Keep the copy out of Git.
// Xcode expands $() to an empty string so URL values retain both slashes.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = com.example.relayconsole

RELAY_CONSOLE_API_BASE_URL = https:/$()/your-backend.up.railway.app/api/v1
# Optional public directory containing illustrated/ and the full avatar catalogue.
RELAY_CONSOLE_AVATAR_ASSET_BASE_URL =
RELAY_CONSOLE_WEB_ASSET_BASE_URL = https:/$()/your-web-app.example.com
RELAY_CONSOLE_WEBSOCKET_BASE_URL = wss:/$()/your-backend.up.railway.app

SENTRY_DSN =
SENTRY_ENVIRONMENT = development
SENTRY_RELEASE =
POSTHOG_PROJECT_TOKEN =
POSTHOG_HOST = https:/$()/eu.i.posthog.com
