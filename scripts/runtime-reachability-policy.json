{
  "schemaVersion": 1,
  "surfaces": {
    "backend": {
      "directory": "backend",
      "tsconfig": "tsconfig.json",
      "sourceDirectories": [
        "src"
      ],
      "entryFiles": [
        "src/main.ts",
        "src/infrastructure/database/data-source.ts",
        "src/seeds/index.ts"
      ],
      "entryDirectories": [
        "src/migrations",
        "src/scripts"
      ],
      "allowlist": {},
      "allowlistPatterns": [
        {
          "pattern": "^src/modules/marketplace/packs/[^/]+/[^/]+\\.ts$",
          "reason": "Marketplace generation scripts discover canonical pack inputs through the filesystem rather than static imports.",
          "workPackage": "WP-12"
        }
      ]
    },
    "web": {
      "directory": "web",
      "tsconfig": "tsconfig.json",
      "sourceDirectories": [
        "app",
        "components",
        "config",
        "hooks",
        "lib",
        "security"
      ],
      "entryFiles": [
        "proxy.ts"
      ],
      "entryDirectories": [
        "app"
      ],
      "allowlist": {},
      "allowlistPatterns": []
    }
  }
}
