# Generate deployable values with:
# node scripts/generate-self-host-railway-env.mjs \
#   --backend-origin https://YOUR-BACKEND.up.railway.app \
#   --web-origin https://YOUR-WEB.example \
#   --database-ca ./railway-postgres-root.crt \
#   --output backend/.env.railway.generated
#
# Do not deploy these placeholders. Production startup rejects them.

NODE_ENV=production
PORT=3000
WS_PORT=3000
API_PREFIX=api/v1
SEED_ON_START=false
CORS_ORIGINS=https://YOUR-WEB.example
JWT_ISSUER=https://YOUR-BACKEND.up.railway.app/api/v1

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_CA_CERT_BASE64=GENERATE_FROM_RAILWAY_POSTGRES_ROOT_CA
DATABASE_TLS_SERVER_NAME=localhost
REDIS_URL=${{Redis.REDIS_URL}}

CLAWCHAT_BETA_SIGNUP_MODE=invite
CLAWCHAT_BETA_INVITE_CODES=GENERATE_UNIQUE_INVITE_CODE
CLAWCHAT_BETA_INVITE_HASH_SECRET=GENERATE_DISTINCT_SECRET
AUDIT_IDENTIFIER_HASH_SECRET=GENERATE_DISTINCT_SECRET
JWT_SECRET=GENERATE_DISTINCT_SECRET
JWT_REFRESH_SECRET=GENERATE_DISTINCT_SECRET
JWT_WS_SECRET=GENERATE_DISTINCT_SECRET
ATTACHMENT_PROVENANCE_SECRET=GENERATE_DISTINCT_SECRET
ATTACHMENT_SIGNING_SECRET=GENERATE_DISTINCT_SECRET
RELAY_OPERATOR_API_SECRET=GENERATE_DISTINCT_SECRET
APP_ENCRYPTION_KEY_VERSION=v1
APP_ENCRYPTION_KEY=base64:GENERATE_32_RANDOM_BYTES
CONNECTION_DESCRIPTOR_PRIVATE_KEY=GENERATE_ED25519_PKCS8_DER_BASE64
CONNECTION_DESCRIPTOR_PUBLIC_KEY=GENERATE_MATCHING_ED25519_SPKI_DER_BASE64
RELAY_SECRET_LIFECYCLE_JSON=GENERATE_WITH_THE_REPOSITORY_SCRIPT

CLAWCHAT_API_DOCS_ENABLED=false
CLAWCHAT_INTERNAL_API_DOCS_ENABLED=false
CLAWCHAT_MARKETPLACE_BETA_MODE=true
CLAWCHAT_MARKETPLACE_ALLOWED_APPS=github,gitlab,linear,notion
CLAWCHAT_MARKETPLACE_BLOCKED_APPS=x,linkedin,stripe,railway,vercel,supabase
RELAY_BILLING_ENABLED=false
RELAY_MANAGED_CLOUD_ENABLED=false
RELAY_TRANSACTIONAL_EMAIL_ENABLED=false
RELAY_APPLE_BILLING_ENABLED=false
