# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Production release identity is non-secret. For a CLI deployment, stage the
# exact integrated 40-character commit with --skip-deploys and use the same
# commit in the Railway deployment message. Railway's Git integration supplies
# RAILWAY_GIT_COMMIT_SHA instead when applicable.
# RELAY_RELEASE_COMMIT=0123456789abcdef0123456789abcdef01234567
# Production also requires RELAY_SECRET_LIFECYCLE_JSON. It is a non-secret
# relay.secret-lifecycle.v1 registry whose material names exactly match the
# value-free audit inventory and whose entries contain version,
# lastRotatedAt, lastReviewedAt, and nextReviewAt. Do not put values, hashes,
# fingerprints, lengths, notes, or other fields in this registry.
CORS_ORIGINS=https://beta.clawchat.example
CLAWCHAT_BETA_INVITE_CODES=replace-with-private-beta-code
CLAWCHAT_BETA_INVITE_HASH_SECRET=replace-with-dedicated-invite-hash-secret
AUDIT_IDENTIFIER_HASH_SECRET=replace-with-dedicated-audit-identifier-hash-secret
# During invite-hash key rotation only; remove after configured hashes migrate.
# CLAWCHAT_BETA_INVITE_HASH_PREVIOUS_SECRETS=replace-with-previous-invite-hash-secret
CLAWCHAT_BETA_SIGNUP_MODE=invite

# API docs
# Non-production defaults to mounted. Production requires the internal flag, so
# public beta deployments do not expose Swagger by accident.
CLAWCHAT_API_DOCS_ENABLED=true
CLAWCHAT_INTERNAL_API_DOCS_ENABLED=false

# Marketplace beta gate
# Keep enabled for public beta so static provider apps are hidden/blocked unless
# explicitly reviewed for tester-owned credentials and no ClawChat-paid usage.
CLAWCHAT_MARKETPLACE_BETA_MODE=true
CLAWCHAT_MARKETPLACE_ALLOWED_APPS=github,gitlab,linear,jira,asana,trello,clickup,notion,google-drive,airtable,dropbox,confluence,coda,sentry,posthog,figma,canva
CLAWCHAT_MARKETPLACE_BLOCKED_APPS=x,resend,gmail,outlook,slack,discord,twilio,exa,dataforseo,linkedin,facebook-pages,instagram-graph-api,threads,tiktok,pinterest,reddit,mastodon,bluesky,stripe,shopify,paddle,lemon-squeezy,chargebee,railway,vercel,supabase,hubspot,salesforce,zendesk,intercom,pipedrive,wordpress,webflow,youtube-data-api

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=clawchat
DATABASE_USER=clawchat
DATABASE_PASSWORD=clawchat_dev_password
# Production must instead pin the database CA and the exact identity in the
# server certificate. Railway's stock postgres-ssl image currently issues its
# server certificate to "localhost"; copy its root.crt out-of-band and base64
# encode the complete PEM. Never add sslmode or other SSL query parameters to
# DATABASE_URL because the application TLS policy is authoritative.
# DATABASE_URL=postgresql://user:password@private-database-host:5432/clawchat
# DATABASE_CA_CERT_BASE64=base64-of-complete-database-root-ca-pem
# DATABASE_TLS_SERVER_NAME=localhost

# Demo seed data is destructive and clears application tables. Production-like
# runtime rejects SEED_ON_START=true and direct seed execution.
SEED_ON_START=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d
JWT_WS_SECRET=your-websocket-secret-change-in-production
JWT_ISSUER=https://your-backend.up.railway.app/api/v1
ATTACHMENT_PROVENANCE_SECRET=your-dedicated-attachment-provenance-secret-change-in-production
ATTACHMENT_SIGNING_SECRET=your-distinct-attachment-upload-signing-secret-change-in-production
BRIDGE_ACCESS_EXPIRES_IN=15m
BRIDGE_WS_EXPIRES_IN=5m
BRIDGE_ACCESS_EXPIRED_GRACE_IN=2m

# Encryption
APP_ENCRYPTION_KEY_VERSION=v1
APP_ENCRYPTION_KEY=base64:replace-with-base64-encoded-32-byte-key
# Optional versioned key ring for rotations:
# APP_ENCRYPTION_KEYS=v1:base64:old-base64-encoded-32-byte-key,v2:base64:new-base64-encoded-32-byte-key

# Relay Cloud billing. Production requires sk_live_; only a Railway environment
# named staging or stage may use sk_test_ for acceptance exercises.
RELAY_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_or_live_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_RELAY_CLOUD_PRICE_ID=price_replace_me
# STRIPE_RELAY_MANAGED_CLOUD_PRICE_ID=price_replace_me
# RELAY_PUBLIC_WEB_ORIGIN=https://your-web.example

# Microsoft 365 / Outlook connector
# Use single_tenant for private/internal Entra app registrations.
MICROSOFT_AUTHORITY_MODE=single_tenant
MICROSOFT_TENANT_ID=your-entra-tenant-id

# WebSocket
WS_PORT=3000

# Hermes local/dev HTTP worker.
# Remote Hermes agents should use adapterKind=hermes_bridge and do not need
# these values in the backend.
HERMES_WORKER_BASE_URL=http://127.0.0.1:8765
HERMES_WORKER_SHARED_SECRET=

# Relay Cloud managed Hermes (separate from Relay Connect). Keep disabled until
# the worker image and dedicated Railway project/environment are provisioned.
RELAY_MANAGED_CLOUD_ENABLED=false
# Railway GraphQL requires a workspace bearer token with access to the dedicated
# managed-runtime project. A project token is not accepted by this integration.
# RELAY_MANAGED_RAILWAY_TOKEN=replace-with-workspace-bearer-token
# RELAY_MANAGED_RAILWAY_PROJECT_ID=replace-with-project-id
# RELAY_MANAGED_RAILWAY_ENVIRONMENT_ID=replace-with-environment-id
# RELAY_MANAGED_HERMES_IMAGE=ghcr.io/relayconsole/hermes-runtime:version
# MANAGED_RUNTIME_CREDENTIAL_MASTER_KEY=replace-with-distinct-32-byte-secret
# RUNTIME_MIGRATION_ENCRYPTION_KEY=replace-with-another-distinct-32-byte-secret

# Rate limiting. These are global defaults; signup/login, bridge enrollment,
# waitlist signup, and marketplace tool routes have stricter code-level limits.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
RATE_LIMIT_FALLBACK_CAPACITY=10000

# Audit privacy and retention. Production enforces these maxima; values may be
# reduced but never increased.
RELAY_AUTH_AUDIT_RETENTION_DAYS=30
RELAY_AUDIT_RETENTION_DAYS=90

# Claude Code CLI wrap-up generation
CLAUDE_CODE_WRAPUP_MODEL=
CLAUDE_CODE_WRAPUP_TIMEOUT_MS=180000
CLAUDE_CODE_ANALYTICS_MODEL=
CLAUDE_CODE_ANALYTICS_TIMEOUT_MS=180000
CLAUDE_CODE_ANALYTICS_MAX_TURNS=8
CLAUDE_CODE_LOCAL_CONTROL_TIMEOUT_MS=120000
CLAUDE_CODE_LOCAL_CONTROL_MAX_TURNS=8

# Condensed team chat summarisation
CONDENSED_TEAM_CHAT_SUMMARIZATION_ENABLED=false
CONDENSED_TEAM_CHAT_REALTIME_ENABLED=false
CONDENSED_TEAM_CHAT_CODEX_COMMAND=codex
CONDENSED_TEAM_CHAT_CODEX_MODEL=
CONDENSED_TEAM_CHAT_CODEX_TIMEOUT_MS=90000
CONDENSED_TEAM_CHAT_CODEX_WORKDIR=
